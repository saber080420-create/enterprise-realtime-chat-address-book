# 在启动后端的终端设置环境变量；不要提交真实 Key。
DEEPSEEK_API_KEY=
# BYOK 用户凭据 AES-256-GCM 加密主密钥：一次生成并安全备份，32 字节的 Base64。
# 页面聊天只使用当前用户保存的 Key，不回退到 DEEPSEEK_API_KEY。
AI_CREDENTIAL_MASTER_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
AI_RAG_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
AI_INDEX_VERSION=bge-m3-1024-chunk600-v1
PGVECTOR_URL=jdbc:postgresql://localhost:5433/enterprise_knowledge
PGVECTOR_USERNAME=knowledge
PGVECTOR_PASSWORD=knowledge_local_demo
AI_RAG_MIN_SCORE=0.45
